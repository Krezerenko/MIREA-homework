<bpmndi:BPMNEdge id="f12_di" bpmnElement="f12"><di:waypoint x="690" y="364"/><di:waypoint x="715" y="364"/><di:waypoint x="715" y="540"/><di:waypoint x="740" y="540"/></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="f13_di" bpmnElement="f13"><di:waypoint x="875" y="540"/><di:waypoint x="967" y="540"/></bpmndi:BPMNEdge>
