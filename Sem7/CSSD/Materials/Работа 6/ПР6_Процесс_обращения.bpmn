<bpmndi:BPMNEdge id="f15_di" bpmnElement="f15"><di:waypoint x="875" y="436"/><di:waypoint x="912" y="436"/></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="m1_di" bpmnElement="m1"><di:waypoint x="95" y="100"/><di:waypoint x="95" y="252"/></bpmndi:BPMNEdge>
