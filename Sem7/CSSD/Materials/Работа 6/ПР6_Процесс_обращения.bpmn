<bpmndi:BPMNEdge id="m3_di" bpmnElement="m3"><di:waypoint x="355" y="100"/><di:waypoint x="355" y="150"/></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="m4_di" bpmnElement="m4"><di:waypoint x="800" y="252"/><di:waypoint x="800" y="100"/></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="m5_di" bpmnElement="m5"><di:waypoint x="985" y="522"/><di:waypoint x="985" y="100"/></bpmndi:BPMNEdge>
</bpmndi:BPMNPlane></bpmndi:BPMNDiagram></bpmn:definitions>