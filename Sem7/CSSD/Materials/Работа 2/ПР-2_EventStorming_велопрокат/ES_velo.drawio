ounded=0;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="623" y="89" width="128" height="112" as="geometry"/></mxCell><mxCell id="n216" value='&lt;div style="font-size:11px;font-style:italic;margin-bottom:3px"&gt;событие&lt;/div&gt;&lt;div style="font-size:13px"&gt;Аренда запрошена&lt;/div&gt;' style="whiteSpace=wrap;html=1;fillColor=#FFA940;strokeColor=#1F1F1F;fontFamily=Arial;fontColor=#000000;verticalAlign=middle;spacing=4;rounded=0;" vertex="1" parent="1"><mxGeometry x="227" y="209" width="128" height="112" as="geometry"/></mxCell><mxCell id="n217" value='&lt;div style="font-size:11px;font-style:italic;margin-bottom:3px"&gt;событие&lt;/div&gt;&lt;div style="font-size:13px"&gt;В аренде отказано&lt;/div&gt;' style="whiteSpace=wrap;html=1;fillColor=#FFA940;strokeColor=#1F1F1F;fontFamily=Arial;fontColor=#000000;verticalAlign=middle;spacing=4;rounded=0;" vertex="1" parent="1"><mxGeometry x="359" y="209" width="128" height="112" as="geometry"/></mxCell><mxCell id="n218" value='&lt;div style="font-size:11px;font-style:italic;margin-bottom:3px"&gt;событие&lt;/div&gt;&lt;div style="font-size:13px"&gt;Аренда отменена&lt;/div&gt;' style="whiteSpace=wrap;html=1;fillColor=#FFA940;strokeColor=#1F1F1F;fontFamily=Arial;fontColor=#000000;verticalAlign=middle;spacing=4;rounded=0;" vertex="1" parent="1"><mxGeometry x="491" y="209" width="128" height="112" as="geometry"/></mxCell><mxCell id="n219" value='&lt;div style="font-size:11px;font-style:italic;margin-bottom:3px"&gt;событие&lt;/div&gt;&lt;div style="font-size:13px"&gt;Аренда закрыта&lt;/div&gt;' style="whiteSpace=wrap;html=1;fillColor=#FFA940;strokeColor=#1F1F1F;fontFamily=Arial;fontColor=#000000;verticalAlign=middle;spacing=4;rounded=0;" vertex="1" parent="1"><mxGeometry x="623" y="209" width="128" height="112" as="geometry"/></mxCell><mxCell id="n220" value='&lt;div style="font-size:11px;font-style:italic;margin-bottom:3px"&gt;событие&lt;/div&gt;&lt;div style="font-size:13px"&gt;Аренда закрыта с задолженностью&lt;/div&gt;' style="whiteSpace=wrap;html=1;fillColor=#FFA940;strokeColor=#1F1F1F;fontFamily=Arial;fontColor=#000000;verticalAlign=middle;spacing=4;rounded=0;" vertex="1" parent="1"><mxGeometry x="755" y="209" width="128" height="112" as="geometry"/></mxCell><mxCell id="t221" value="&lt;b&gt;Инварианты&lt;/b&gt;&lt;br&gt;• У клиента не более одной незавершённой аренды&lt;br&gt;• Закрытая или отменённая аренда повторно не открывается&lt;br&gt;• Пока у клиента есть непогашенная задолженность, незавершённых аренд у него нет" style="text;html=1;fontFamily=Arial;fontColor=#000000;fontSize=14;align=left;verticalAlign=top;whiteSpace=wrap;spacing=8;fillColor=#FFFFFF;strokeColor=#BFBFBF;" vertex="1" parent="1"><mxGeometry x="1042" y="90" width="458" height="276" as="geometry"/></mxCell><mxCell id="c222" value="" style="rounded=0;html=1;fillColor=#FAFAFA;strokeColor=#808080;" vertex="1" parent="1"><mxGeometry x="30" y="400" width="1480" height="296" as="geometry"/></mxCell><mxCell id="n223" value='&lt;div style="font-size:11px;font-style:italic;margin-bottom:3px"&gt;агрегат&lt;/div&gt;&lt;div style="font-size:14px"&gt;Поездка&lt;/div&gt;' style="whiteSpace=wrap;html=1;fillColor=#FFE58F;strokeColor=#1F1F1F;fontFamily=Arial;fontColor=#000000;verticalAlign=middle;spacing=4;rounded=0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="45" y="458" width="140" height="140" as="geometry"/></mxCell><mxCell id="t224" value="контекст «Аренда»" style="text;html=1;fontFamily=Arial;fontColor=#000000;fontSize=12;fontStyle=2;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="605" width="150" height="24" as="geometry"/></mxCell><mxCell id="n225" value='&lt;div style="font-size:11px;font-style:italic;margin-bottom:3px"&gt;команда&lt;/div&gt;&lt;div style="font-size:13px"&gt;Начать поездку&lt;/div&gt;' style="whiteSpace=wrap;html=1;fillColor=#69B1FF;strokeColor=#1F1F1F;fontFamily=Arial;fontColor=#000000;verticalAlign=middle;spacing=4;rounded=0;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="227" y="409" width="128" height="112" as="geometry"/></mxCell><mxCell id="n226" value='&lt;div style="font-size:11px;font-style:italic;margin-bottom:3px"&gt;команда&lt;/div&gt;&lt;div style="font-size:13px"&gt;Завершить поездку&lt;/div&gt;' style="whiteSpace=wrap;html=1;fillColor=#69B1FF;strokeColor=#1F1F1F;fontFamily=Arial;fontColor=#000000;verticalAlign=middle;spacing=4;rounded=0;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="359" y="409" width="128" height="112" as="geometry"/></mxCell><mxCell id="n227" value='&lt;div style="font-size:11px;font-style:italic;margin-bottom:3px"&gt;команда&lt;/div&gt;&lt;div style="font-size:13px"&gt;Рассчитать стоимость поездки&lt;/div&gt;' style="whiteSpace=wrap;html=1;fillColor=#69B1FF;strokeColor=#1F1F1F;fontFamily=Arial;fontColor=#000000;verticalAlign=middle;spacing=4;rounded=0;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="491" y="409" width="128" height="112" as="geometry"/></mxCell><mxCell id="n228" value='&lt;div style="font-size:11px;font-style:italic;margin-bottom:3px"&gt;событие&lt;/div&gt;&lt;div style="font-size:13px"&gt;Поездка начата&lt;/div&gt;' style="whiteSpace=wrap;html=1;fillColor=#FFA940;strokeColor=#1F1F1F;fontFamily=Arial;fontColor=#000000;verticalAlign=middle;spacing=4;rounded=0;" vertex="1" parent="1"><mxGeometry x="227" y="529" width="128" height="112" as="geometry"/></mxCell><mxCell id="n229" value='&lt;div style="font-size:11px;font-style:italic;margin-bottom:3px"&gt;событие&lt;/div&gt;&lt;div style="font-size:13px"&gt;Поездка завершена&lt;/div&gt;' style="whiteSpace=wrap;html=1;fillColor=#FFA940;strokeColor=#1F1F1F;fontFamily=Arial;fontColor=#000000;verticalAlign=middle;spacing=4;rounded=0;" vertex="1" parent="1"><mxGeometry x="359" y="529" width="128" height="112" as="geometry"/></mxCell><mxCell id="n230" value='&lt;div style="font-size:11px;font-style:italic;margin-bottom:3px"&gt;событие&lt;/div&gt;&lt;div style="font-size:13px"&gt;Стоимость поездки рассчитана&lt;/div&gt;' style="whiteSpace=wrap;html=1;fillColor=#FFA940;strokeColor=#1F1F1F;fontFamily=Arial;fontColor=#000000;verticalAlign=middle;spacing=4;rounded=0;" vertex="1" parent="1"><mxGeometry x="491" y="529" width="128" height="112" as="geometry"/></mxCell><mxCell id="t231" value="&lt;b&gt;Инварианты&lt;/b&gt;&lt;br&gt;• Время завершения поездки не раньше времени её начала&lt;br&gt;• Стоимость рассчитывается один раз и только для завершённой поездки" style="text;html=1;fontFamily=Arial;fontColor=#000000;fontSize=14;align=left;verticalAlign=top;whiteSpace=wrap;spacing=8;fillColor=#FFFFFF;strokeColor=#BFBFBF;" vertex="1" parent="1"><mxGeometry x="1042" y="410" width="458" height="276" as="geometry"/></mxCell><mxCell id="c232" value="" style="rounded=0;html=1;fillColor=#FAFAFA;strokeColor=#808080;" vertex="1" parent="1"><mxGeometry x="30" y="720" width="1480" height="296" as="geometry"/></mxCell><mxCell id="n233" value='&lt;div style="font-size:11px;font-style:italic;margin-bottom:3px"&gt;агрегат&lt;/div&gt;&lt;div style="font-size:14px"&gt;Платёж&lt;/div&gt;' style="whiteSpace=wrap;html=1;fillColor=#FFE58F;strokeColor=#1F1F1F;fontFamily=Arial;fontColor=#000000;verticalAlign=middle;spacing=4;rounded=0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="45" y="778" width="140" height="140" as="geometry"/></mxCell><mxCell id="t234" value="контекст «Расчёты»" style="text;html=1;fontFamily=Arial;fontColor=#000000;fontSize=12;fontStyle=2;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="925" width="150" height="24" as="geometry"/></mxCell><mxCell id="n235" value='&lt;div style="font-size:11px;font-style:italic;margin-bottom:3px"&gt;команда&lt;/div&gt;&lt;div style="font-size:13px"&gt;Заблокировать залог&lt;/div&gt;' style="whiteSpace=wrap;html=1;fillColor=#69B1FF;strokeColor=#1F1F1F;fontFamily=Arial;fontColor=#000000;verticalAlign=middle;spacing=4;rounded=0;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="227" y="729" width="128" height="112" as="geometry"/></mxCell><mxCell id="n236"