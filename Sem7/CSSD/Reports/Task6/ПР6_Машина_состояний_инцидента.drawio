<mxfile host="app.diagrams.net"><diagram name="Машина состояний" id="sm1"><mxGraphModel dx="1400" dy="520" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1340" pageHeight="520" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="11" value="Машина состояний инцидента утраты записи: значения поля loss_incidents.status" style="text;html=1;fontSize=15;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="0" width="800" height="30" as="geometry"/></mxCell><mxCell id="12" value="" style="ellipse;fillColor=#1F3A5F;strokeColor=#1F3A5F;" vertex="1" parent="1"><mxGeometry x="40" y="135" width="26" height="26" as="geometry"/></mxCell><mxCell id="13" value="&lt;b&gt;На разборе&lt;/b&gt;&lt;br&gt;&lt;i&gt;checking&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#E8F0FA;strokeColor=#5B7FB5;fontSize=12;" vertex="1" parent="1"><mxGeometry x="170" y="118" width="200" height="60" as="geometry"/></mxCell><mxCell id="14" value="&lt;b&gt;Ожидает файл от владельца&lt;/b&gt;&lt;br&gt;&lt;i&gt;awaiting_owner&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#E8F0FA;strokeColor=#5B7FB5;fontSize=12;" vertex="1" parent="1"><mxGeometry x="560" y="118" width="230" height="60" as="geometry"/></mxCell><mxCell id="15" value="&lt;b&gt;Утрата подтверждена&lt;/b&gt;&lt;br&gt;&lt;i&gt;loss_confirmed&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#E8F0FA;strokeColor=#5B7FB5;fontSize=12;" vertex="1" parent="1"><mxGeometry x="960" y="118" width="200" height="60" as="geometry"/></mxCell><mxCell id="16" value="&lt;b&gt;Запись восстановлена&lt;/b&gt;&lt;br&gt;&lt;i&gt;restored&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#E8F0FA;strokeColor=#5B7FB5;fontSize=12;" vertex="1" parent="1"><mxGeometry x="560" y="320" width="230" height="60" as="geometry"/></mxCell><mxCell id="17" value="" style="ellipse;html=1;shape=endState;fillColor=#1F3A5F;strokeColor=#1F3A5F;" vertex="1" parent="1"><mxGeometry x="1260" y="230" width="30" height="30" as="geometry"/></mxCell><mxCell id="18" value="утрата обнаружена&lt;br&gt;при сверке или файл&lt;br&gt;не найден при скачивании" style="endArrow=block;endFill=1;html=1;rounded=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#FFFFFF;edgeStyle=none;" edge="1" parent="1" source="12" target="13"><mxGeometry relative="1" as="geometry"><mxPoint x="-20" y="-44" as="offset"/></mxGeometry></mxCell><mxCell id="19" value="копии нет, запрос отправлен" style="endArrow=block;endFill=1;html=1;rounded=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#FFFFFF;edgeStyle=none;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="13" target="14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="20" value="файл получен" style="endArrow=block;endFill=1;html=1;rounded=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#FFFFFF;edgeStyle=none;exitX=0;exitY=0.75;exitDx=0;exitDy=0;entryX=1;entryY=0.75;entryDx=0;entryDy=0;" edge="1" parent="1" source="14" target="13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="21" value="нет ответа 5 суток" style="endArrow=block;endFill=1;html=1;rounded=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#FFFFFF;edgeStyle=none;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="14" target="15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="22" value="контрольная сумма совпала" style="endArrow=block;endFill=1;html=1;rounded=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#FFFFFF;edgeStyle=none;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="13" target="16"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="270" y="350"/></Array></mxGeometry></mxCell><mxCell id="23" value="контрольная сумма не совпала" style="endArrow=block;endFill=1;html=1;rounded=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#FFFFFF;edgeStyle=none;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="13" target="15"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="270" y="70"/><mxPoint x="1060" y="70"/></Array></mxGeometry></mxCell><mxCell id="24" value="" style="endArrow=block;endFill=1;html=1;rounded=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#FFFFFF;edgeStyle=none;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="16" target="17"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1275" y="350"/></Array></mxGeometry></mxCell><mxCell id="25" value="" style="endArrow=block;endFill=1;html=1;rounded=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#FFFFFF;edgeStyle=none;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="15" target="17"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1275" y="148"/></Array></mxGeometry></mxCell><mxCell id="26" value="Переход по времени подписан значением: 5 суток ожидания файла от владельца серверов.&lt;br&gt;Эскалация через 4 ч состояния инцидента не меняет: она меняет исполнителя.&lt;br&gt;Уведомления владельцу и пользователям отправляются при переходе в конечное состояние и новых состояний не образуют.&lt;br&gt;Успешная выдача файла по запросу пользователя инцидента не создаёт.&lt;br&gt;Под названием состояния указано значение поля loss_incidents.status." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#2F4F7F;" vertex="1" parent="1"><mxGeometry x="40" y="420" width="900" height="80" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>