trokeColor=#1F1F1F;fontFamily=Arial;fontColor=#000000;verticalAlign=middle;spacing=4;rounded=0;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="227" y="89" width="128" height="112" as="geometry"/></mxCell><mxCell id="n163" value='&lt;div style="font-size:11px;font-style:italic;margin-bottom:3px"&gt;команда&lt;/div&gt;&lt;div style="font-size:13px"&gt;Учесть объём в квоте&lt;/div&gt;' style="whiteSpace=wrap;html=1;fillColor=#69B1FF;strokeColor=#1F1F1F;fontFamily=Arial;fontColor=#000000;verticalAlign=middle;spacing=4;rounded=0;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="359" y="89" width="128" height="112" as="geometry"/></mxCell><mxCell id="n164" value='&lt;div style="font-size:11px;font-style:italic;margin-bottom:3px"&gt;событие&lt;/div&gt;&lt;div style="font-size:13px"&gt;Ключ сервера выпущен&lt;/div&gt;' style="whiteSpace=wrap;html=1;fillColor=#FFA940;strokeColor=#1F1F1F;fontFamily=Arial;fontColor=#000000;verticalAlign=middle;spacing=4;rounded=0;" vertex="1" parent="1"><mxGeometry x="227" y="209" width="128" height="112" as="geometry"/></mxCell><mxCell id="n165" value='&lt;div style="font-size:11px;font-style:italic;margin-bottom:3px"&gt;событие&lt;/div&gt;&lt;div style="font-size:13px"&gt;Объём хранения учтён&lt;/div&gt;' style="whiteSpace=wrap;html=1;fillColor=#FFA940;strokeColor=#1F1F1F;fontFamily=Arial;fontColor=#000000;verticalAlign=middle;spacing=4;rounded=0;" vertex="1" parent="1"><mxGeometry x="359" y="209" width="128" height="112" as="geometry"/></mxCell><mxCell id="n166" value='&lt;div style="font-size:11px;font-style:italic;margin-bottom:3px"&gt;событие&lt;/div&gt;&lt;div style="font-size:13px"&gt;Квота хранения исчерпана&lt;/div&gt;' style="whiteSpace=wrap;html=1;fillColor=#FFA940;strokeColor=#1F1F1F;fontFamily=Arial;fontColor=#000000;verticalAlign=middle;spacing=4;rounded=0;" vertex="1" parent="1"><mxGeometry x="491" y="209" width="128" height="112" as="geometry"/></mxCell><mxCell id="t167" value="&lt;b&gt;Инварианты&lt;/b&gt;&lt;br&gt;• Отозванный ключ сервера не становится снова действующим&lt;br&gt;• Учтённый объём хранения равен сумме объёмов принятых реплеев владельца" style="text;html=1;fontFamily=Arial;fontColor=#000000;fontSize=14;align=left;verticalAlign=top;whiteSpace=wrap;spacing=8;fillColor=#FFFFFF;strokeColor=#BFBFBF;" vertex="1" parent="1"><mxGeometry x="1042" y="90" width="458" height="276" as="geometry"/></mxCell><mxCell id="c168" value="" style="rounded=0;html=1;fillColor=#FAFAFA;strokeColor=#808080;" vertex="1" parent="1"><mxGeometry x="30" y="400" width="1480" height="296" as="geometry"/></mxCell><mxCell id="n169" value='&lt;div style="font-size:11px;font-style:italic;margin-bottom:3px"&gt;агрегат&lt;/div&gt;&lt;div style="font-size:14px"&gt;Реплей&lt;/div&gt;' style="whiteSpace=wrap;html=1;fillColor=#FFE58F;strokeColor=#1F1F1F;fontFamily=Arial;fontColor=#000000;verticalAlign=middle;spacing=4;rounded=0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="45" y="458" width="140" height="140" as="geometry"/></mxCell><mxCell id="t170" value="контекст «Приём»" style="text;html=1;fontFamily=Arial;fontColor=#000000;fontSize=12;fontStyle=2;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="605" width="150" height="24" as="geometry"/></mxCell><mxCell id="n171" value='&lt;div style="font-size:11px;font-style:italic;margin-bottom:3px"&gt;команда&lt;/div&gt;&lt;div style="font-size:13px"&gt;Выгрузить реплей&lt;/div&gt;' style="whiteSpace=wrap;html=1;fillColor=#69B1FF;strokeColor=#1F1F1F;fontFamily=Arial;fontColor=#000000;verticalAlign=middle;spacing=4;rounded=0;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="227" y="409" width="128" height="112" as="geometry"/></mxCell><mxCell id="n172" value='&lt;div style="font-size:11px;font-style:italic;margin-bottom:3px"&gt;событие&lt;/div&gt;&lt;div style="font-size:13px"&gt;Реплей принят&lt;/div&gt;' style="whiteSpace=wrap;html=1;fillColor=#FFA940;strokeColor=#1F1F1F;fontFamily=Arial;fontColor=#000000;verticalAlign=middle;spacing=4;rounded=0;" vertex="1" parent="1"><mxGeometry x="227" y="529" width="128" height="112" as="geometry"/></mxCell><mxCell id="n173" value='&lt;div style="font-size:11px;font-style:italic;margin-bottom:3px"&gt;событие&lt;/div&gt;&lt;div style="font-size:13px"&gt;Реплей отклонён&lt;/div&gt;' style="whiteSpace=wrap;html=1;fillColor=#FFA940;strokeColor=#1F1F1F;fontFamily=Arial;fontColor=#000000;verticalAlign=middle;spacing=4;rounded=0;" vertex="1" parent="1"><mxGeometry x="359" y="529" width="128" height="112" as="geometry"/></mxCell><mxCell id="t174" value="&lt;b&gt;Инварианты&lt;/b&gt;&lt;br&gt;• Для одного матча принимается не более одного реплея&lt;br&gt;• Приём подтверждается только после сохранения файла в хранилище&lt;br&gt;• Контрольная сумма принятого реплея не меняется" style="text;html=1;fontFamily=Arial;fontColor=#000000;fontSize=14;align=left;verticalAlign=top;whiteSpace=wrap;spacing=8;fillColor=#FFFFFF;strokeColor=#BFBFBF;" vertex="1" parent="1"><mxGeometry x="1042" y="410" width="458" height="276" as="geometry"/></mxCell><mxCell id="c175" value="" style="rounded=0;html=1;fillColor=#FAFAFA;strokeColor=#808080;" vertex="1" parent="1"><mxGeometry x="30" y="720" width="1480" height="296" as="geometry"/></mxCell><mxCell id="n176" value='&lt;div style="font-size:11px;font-style:italic;margin-bottom:3px"&gt;агрегат&lt;/div&gt;&lt;div style="font-size:14px"&gt;Карточка матча&lt;/div&gt;' style="whiteSpace=wrap;html=1;fillColor=#FFE58F;strokeColor=#1F1F1F;fontFamily=Arial;fontColor=#000000;verticalAlign=middle;spacing=4;rounded=0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="45" y="778" width="140" height="140" as="geometry"/></mxCell><mxCell id="t177" value="контекст «Каталог и доступ»" style="text;html=1;fontFamily=Arial;fontColor=#000000;fontSize=12;fontStyle=2;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="925" width="150" height="24" as="geometry"/></mxCell><mxCell id="n178" value='&lt;div style="font-size:11px;font-style:italic;margin-bottom:3px"&gt;команда&lt;/div&gt;&lt;div style="font-size:13px"&gt;Внести матч в каталог&lt;/div&gt;' style="whiteSpace=wrap;html=1;fillColor=#69B1FF;strokeColor=#1F1F1F;fontFamily=Arial;fontColor=#000000;verticalAlign=middle;spacing=4;rounded=0;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="227" y="729" width="128" height="112" as="geometry"/></mxCell><mxCell id="n179" value='&lt;div style="font-size:11px;font-style:italic;margin-bottom:3px"&gt;команда&lt;/div&gt;&lt;div style="font-size:13px"&gt;Изменить уровень доступа матча&lt;/div&gt;' style="whiteSpace=wrap;html=1;fillColor=#69B1FF;strokeColor=#1F1F1F;fontFamily=Arial;fontColor=#000000;verticalAlign=middle;spacing=4;rounded=0;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="359" y="729" width="128" height="112" as="geometry"/></mxCell><mxCell id="n180" value='&lt;div style="font-size:11px;font-style:italic;margin-bottom:3px"&gt;команда&lt;/div&gt;&lt;div style="font-size:13px"&gt;Скачать реплей&lt;/div&gt;' style="whiteSpace=wrap;html=1;fillColor=#69B1FF;strokeColor=#1F1F1F;fontFamily=Arial;fontColor=#000000;verticalAlign=middle;spacing=4;rounded=0;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="491" y="729" width="128" height="112" as="geometry"/></mxCell><mxCell id="n181" value='&lt;div style="font-size:11px;font-style:italic;margin-bottom:3px"&gt;команда&lt;/div&gt;&lt;div style="font-size:13px"&gt;Исключить матч из каталога&lt;/div&gt;' style="whiteSpace=wrap;html=1;fillColor=#69B1FF;strokeColor=#1F1F1F;fontFamily=Arial;fontColor=#000000;verticalAlign=middle;spacing=4;rounded=0;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="623" y="729" width="128" height="112" as="geometry"/></mxCell><mxCell id="n182" value='&lt;div style="font-size:11px;font-style:italic;margin-bottom:3px"&gt;событие&lt;/div&gt;&lt;div style="font-size:13px"&gt;Матч внесён в каталог&lt;/div&gt;' style="whiteSpace=wrap;html=1;fillColor=#FFA940;strokeColor=#1F1F1F;fontFamily=Arial;fontColor=#000000;verticalAlign=middle;spacing=4;rounded=0;" vertex="1" parent="1"><mxGeometry x="227" y="849" width="128" height="112" as="geometry"/></mxCell><mxCell id="n183" value='&lt;div style="font-size:11px;font-style:italic;margin-bottom:3px"&gt;событие&lt;/div&gt;&lt;div style="font-size:13px"&gt;Уровень доступа матча изменён&lt;/div&gt;' style="whiteSpace=wrap;html=1;fillColor=#FFA940;strokeColor=#1F1F1F;fontFamily=Arial;fontColor=#000000;verticalAlign=middle;spacing=4;rounded=0;" vertex="1" parent="1"><mxGeometry x="359" y="849" width="128" height="112" as="geometry"/></mxCell><mxCell id="n184" value='&lt;div style="font-size:11px;font-style:italic;margin-bottom:3px"&gt;событие&lt;/div&gt;&lt;div style="font-size:13px"&gt;Реплей выдан&lt;/div&gt;' style="whiteSpace=wrap;html=1;fillColor=#FFA940;strokeColor=#1F1F1F;fontFamily=Arial;fontColor=#000000;verticalAlign=middle;spacing=4;rounded=0;" vertex="1" parent="1"><mxGeometry x="491" y="849" width="128" height="112" as="geometry"/></mxCell><mxCell id="n185" value='&lt;div style="font-size:11px;font-style:italic;margin-bottom:3px"&gt;событие&lt;/div&gt;&lt;div style="font-size:13px"&gt;В выдаче реплея отказано&lt;/div&gt;' style="whiteSpace=wrap;html=1;fillColor=#FFA940;strokeColor=#1F1F1F;fontFamily=Arial;fontColor=#000000;verticalAlign=middle;spacing=4;rounded=0;" vertex="1" parent="1"><mxGeometry x="623" y="849" width="128" height="112" as="geometry"/></mxCell><mxCell id="n186" value='&lt;div style="font-size:11px;font-style:italic;margin-bottom:3px"&gt;событие&lt;/div&gt;&lt;div style="font-size:13px"&gt;Матч исключён из каталога&lt;/div&gt;' style="whiteSpace=wrap;html=1;fillColor=#FFA940;strokeColor=#1F1F1F;fontFamily=Arial;fontColor=#000000;verticalAlign=middle;spacing=4;rounded=0;" vertex="1" parent="1"><mxGeometry x="755" y="849" width="128" height="112" as="geometry"/></mxCell><mxCell id="t187" value="&lt;b&gt;Инварианты&lt;/b&gt;&lt;br&gt;• Карточка создаётся только для принятого реплея&lt;br&gt;• Скрытый матч выдаётся только участникам матча и владельцу серверов&lt;br&gt;• Матч, исключённый из каталога, не выдаётся никому" style="text;html=1;fontFamily=Arial;fontColor=#000000;fontSize=14;align=left;verticalAlign=top;whiteSpace=wrap;spacing=8;fillColor=#FFFFFF;strokeColor=#BFBFBF;" vertex="1" parent="1"><mxGeometry x="1042" y="730" width="458" height="276" as="geometry"/></mxCell><mxCell id="c188" value="" style="rounded=0;html=1;fillColor=#FAFAFA;strokeColor=#808080;" vertex="1" parent="1"><mxGeometry x="30" y="1040" width="1480" height="296" as="geometry"/></mxCell><mxCell id="n189" value='&lt;div style="font-size:11px;font-style:italic;margin-bottom:3px"&gt;агрегат&lt;/div&gt;&lt;div style="font-size:14px"&gt;Профиль игрока&lt;/div&gt;' style="whiteSpace=wrap;html=1;fillColor=#FFE58F;strokeColor=#1F1F1F;fontFamily=Arial;fontColor=#000000;verticalAlign=middle;spacing=4;rounded=0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="45" y="1098" width="140" height="140" as="geometry"/></mxCell><mxCell id="t190" value="контекст «Каталог и доступ»" style="text;html=1;fontFamily=Arial;fontColor=#000000;fontSize=12;fontStyle=2;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="1245" width="150" height="24" as="geometry"/></mxCell><mxCell id="n191" value='&lt;div style="font-size:11px;font-style:italic;margin-bottom:3px"&gt;команда&lt;/div&gt;&lt;div style="font-size:13px"&gt;Сопоставить матч с профилями участников&lt;/div&gt;' style="whiteSpace=wrap;html=1;fillColor=#69B1FF;strokeColor=#1F1F1F;fontFamily=Arial;fontColor=#000000;verticalAlign=middle;spacing=4;rounded=0;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="227" y="1049" width="128" height="112" as="geometry"/></mxCell><mxCell id="n192" value='&lt;div style="font-size:11px;font-style:italic;margin-bottom:3px"&gt;команда&lt;/div&gt;&lt;div style="font-size:13px"&gt;Удалить свои данные&lt;/div&gt;' style="whiteSpace=wrap;html=1;fillColor=#69B1FF;strokeColor=#1F1F1F;fontFamily=Arial;fontColor=#000000;verticalAlign=middle;spacing=4;rounded=0;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="359" y="1049" width="128" height="112" as="geometry"/></mxCell><mxCell id="n193" value='&lt;div style="font-size:11px;font-style:italic;margin-bottom:3px"&gt;событие&lt;/div&gt;&lt;div style="font-size:13px"&gt;Матч сопоставлен с профилями участников&lt;/div&gt;' style="whiteSpace=wrap;html=1;fillColor=#FFA940;strokeColor=#1F1F1F;fontFamily=Arial;fontColor=#000000;verticalAlign=middle;spacing=4;rounded=0;" vertex="1" parent="1"><mxGeometry x="227" y="1169" width="128" height="112" as="geometry"/></mxCell><mxCell id="n194" value='&lt;div style="font-size:11px;font-style:italic;margin-bottom:3px"&gt;событие&lt;/div&gt;&lt;div style="font-size:13px"&gt;Данные игрока удалены&lt;/div&gt;' style="whiteSpace=wrap;html=1;fillColor=#FFA940;strokeColor=#1F1F1F;fontFamily=Arial;fontColor=#000000;verticalAlign=middle;spacing=4;rounded=0;" vertex="1" parent="1"><mxGeometry x="359" y="1169" width="128" height="112" as="geometry"/></mxCell><mxCell id="t195" value="&lt;b&gt;Инварианты&lt;/b&gt;&lt;br&gt;• Одному аккаунту Steam соответствует не более одного профиля&lt;br&gt;• После удаления данных игрока профиль не связан ни с одним матчем" style="text;html=1;fontFamily=Arial;fontColor=#000000;fontSize=14;align=left;verticalAlign=top;whiteSpace=wrap;spacing=8;fillColor=#FFFFFF;strokeColor=#BFBFBF;" vertex="1" parent="1"><mxGeometry x="1042" y="1050" width="458" height="276" as="geometry"/></mxCell><mxCell id="c196" value="" style="rounded=0;html=1;fillColor=#FAFAFA;strokeColor=#808080;" vertex="1" parent="1"><mxGeometry x="30" y="1360" width="1480" height="296" as="geometry"/></mxCell><mxCell id="n197" value='&lt;div style="font-size:11px;font-style:italic;margin-bottom:3px"&gt;агрегат&lt;/div&gt;&lt;div style="font-size:14px"&gt;Запись в хранилище&lt;/div&gt;' style="whiteSpace=wrap;html=1;fillColor=#FFE58F;strokeColor=#1F1F1F;fontFamily=Arial;fontColor=#000000;verticalAlign=middle;spacing=4;rounded=0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="45" y="1418" width="140" height="140" as="geometry"/></mxCell><mxCell id="t198" value="контекст «Хранение»" style="text;html=1;fontFamily=Arial;fontColor=#000000;fontSize=12;fontStyle=2;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="1565" width="150" height="24" as="geometry"/></mxCell><mxCell id="n199" value='&lt;div style="font-size:11px;font-style:italic;margin-bottom:3px"&gt;команда&lt;/div&gt;&lt;div style="font-size:13px"&gt;Назначить срок хранения&lt;/div&gt;' style="whiteSpace=wrap;html=1;fillColor=#69B1FF;strokeColor=#1F1F1F;fontFamily=Arial;fontColor=#000000;verticalAlign=middle;spacing=4;rounded=0;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="227" y="1369" width="128" height="112" as="geometry"/></mxCell><mxCell id="n200" value='&lt;div style="font-size:11px;font-style:italic;margin-bottom:3px"&gt;команда&lt;/div&gt;&lt;div style="font-size:13px"&gt;Перевести запись в холодный класс&lt;/div&gt;' style="whiteSpace=wrap;html=1;fillColor=#69B1FF;strokeColor=#1F1F1F;fontFamily=Arial;fontColor=#000000;verticalAlign=middle;spacing=4;rounded=0;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="359" y="1369" width="128" height="112" as="geometry"/></mxCell><mxCell id="n201" value='&lt;div style="font-size:11px;font-style:italic;margin-bottom:3px"&gt;команда&lt;/div&gt;&lt;div style="font-size:13px"&gt;Удалить запись по истечении срока&lt;/div&gt;' style="whiteSpace=wrap;html=1;fillColor=#69B1FF;strokeColor=#1F1F1F;fontFamily=Arial;fontColor=#000000;verticalAlign=middle;spacing=4;rounded=0;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="491" y="1369" width="128" height="112" as="geometry"/></mxCell><mxCell id="n202" value='&lt;div style="font-size:11px;font-style:italic;margin-bottom:3px"&gt;команда&lt;/div&gt;&lt;div style="font-size:13px"&gt;Сверить каталог с хранилищем&lt;/div&gt;' style="whiteSpace=wrap;html=1;fillColor=#69B1FF;strokeColor=#1F1F1F;fontFamily=Arial;fontColor=#000000;verticalAlign=middle;spacing=4;rounded=0;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="623" y="1369" width="128" height="112" as="geometry"/></mxCell><mxCell id="n203" value='&lt;div style="font-size:11px;font-style:italic;margin-bottom:3px"&gt;событие&lt;/div&gt;&lt;div style="font-size:13px"&gt;Срок хранения назначен&lt;/div&gt;' style="whiteSpace=wrap;html=1;fillColor=#FFA940;strokeColor=#1F1F1F;fontFamily=Arial;fontColor=#000000;verticalAlign=middle;spacing=4;rounded=0;" vertex="1" parent="1"><mxGeometry x="227" y="1489" width="128" height="112" as="geometry"/></mxCell><mxCell id="n204" value='&lt;div style="font-size:11px;font-style:italic;margin-bottom:3px"&gt;событие&lt;/div&gt;&lt;div style="font-size:13px"&gt;Запись переведена в холодный класс&lt;/div&gt;' style="whiteSpace=wrap;html=1;fillColor=#FFA940;strokeColor=#1F1F1F;fontFamily=Arial;fontColor=#000000;verticalAlign=middle;spacing=4;rounded=0;" vertex="1" parent="1"><mxGeometry x="359" y="1489" width="128" height="112" as="geometry"/></mxCell><mxCell id="n205" value='&lt;div style="font-size:11px;font-style:italic;margin-bottom:3px"&gt;событие&lt;/div&gt;&lt;div style="font-size:13px"&gt;Запись удалена по истечении срока&lt;/div&gt;' style="whiteSpace=wrap;html=1;fillColor=#FFA940;strokeColor=#1F1F1F;fontFamily=Arial;fontColor=#000000;verticalAlign=middle;spacing=4;rounded=0;" vertex="1" parent="1"><mxGeometry x="491" y="1489" width="128" height="112" as="geometry"/></mxCell><mxCell id="n206" value='&lt;div style="font-size:11px;font-style:italic;margin-bottom:3px"&gt;событие&lt;/div&gt;&lt;div style="font-size:13px"&gt;Сверка каталога с хранилищем выполнена&lt;/div&gt;' style="whiteSpace=wrap;html=1;fillColor=#FFA940;strokeColor=#1F1F1F;fontFamily=Arial;fontColor=#000000;verticalAlign=middle;spacing=4;rounded=0;" vertex="1" parent="1"><mxGeometry x="623" y="1489" width="128" height="112" as="geometry"/></mxCell><mxCell id="n207" value='&lt;div style="font-size:11px;font-style:italic;margin-bottom:3px"&gt;событие&lt;/div&gt;&lt;div style="font-size:13px"&gt;Утрата записи обнаружена&lt;/div&gt;' style="whiteSpace=wrap;html=1;fillColor=#FFA940;strokeColor=#1F1F1F;fontFamily=Arial;fontColor=#000000;verticalAlign=middle;spacing=4;rounded=0;" vertex="1" parent="1"><mxGeometry x="755" y="1489" width="128" height="112" as="geometry"/></mxCell><mxCell id="t208" value="&lt;b&gt;Инварианты&lt;/b&gt;&lt;br&gt;• В холодный класс переводится только запись старше 30 дней&lt;br&gt;• Удалённая запись не восстанавливается и не выдаётся" style="text;html=1;fontFamily=Arial;fontColor=#000000;fontSize=14;align=left;verticalAlign=top;whiteSpace=wrap;spacing=8;fillColor=#FFFFFF;strokeColor=#BFBFBF;" vertex="1" parent="1"><mxGeometry x="1042" y="1370" width="458" height="276" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="ctx" name="Контексты"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2000" pageHeight="1210" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t209" value="Границы ограниченных контекстов" style="text;html=1;fontFamily=Arial;fontColor=#000000;fontSize=24;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="900" height="40" as="geometry"/></mxCell><mxCell id="cx210" value="Контекст «Приём»" style="rounded=1;arcSize=3;html=1;fontFamily=Arial;fontColor=#000000;fontSize=18;fontStyle=1;verticalAlign=top;dashed=1;dashPattern=10 5;strokeWidth=2;fillColor=#FAFAFA;strokeColor=#404040;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="420" height="640" as="geometry"/></mxCell><mxCell id="n211" value='&lt;div style="font-size:11px;font-style:italic;margin-bottom:3px"&gt;агрегат&lt;/div&gt;&lt;div style="font-size:14px"&gt;Владелец серверов&lt;/div&gt;' style="whiteSpace=wrap;html=1;fillColor=#FFE58F;strokeColor=#1F1F1F;fontFamily=Arial;fontColor=#000000;verticalAlign=middle;spacing=4;rounded=0;strokeWidth=2;" vertex="