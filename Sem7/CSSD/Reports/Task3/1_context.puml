@startuml 1_context
!include <C4/C4_Context>

title Уровень 1. Системный контекст: платформа хранения игровых повторов

Person(player, "Игрок", "Ищет и скачивает записи своих матчей")
Person(viewer, "Зритель", "Ищет и скачивает записи популярных матчей")
Person(owner, "Владелец серверов", "Студия или хост комьюнити-серверов; подключает серверы и управляет доступом к записям")

System(platform, "Платформа хранения игровых повторов", "Принимает записи матчей от игровых серверов, хранит их, ведёт каталог и выдаёт записи по правилам доступа")

System_Ext(gs, "Выделенный игровой сервер", "Проводит матч и по его окончании передаёт запись")
System_Ext(s3, "Облачное хранилище", "Хранит файлы реплеев")
System_Ext(notify, "Служба уведомлений", "Доставляет письма владельцу серверов и оповещения дежурному инженеру")
System_Ext(auth, "Служба аутентификации Steam / Epic", "Подтверждает личность игрока при входе")

Rel_D(player, platform, "Ищет свои матчи, скачивает записи, удаляет свои данные")
Rel_D(viewer, platform, "Ищет и скачивает публичные записи")
Rel_D(owner, platform, "Выпускает ключи серверов, меняет уровни доступа")
Rel_R(gs, platform, "Передаёт запись и данные завершённого матча")
Rel_D(platform, s3, "Сохраняет, переводит в холодный класс и удаляет файлы реплеев")
Rel_D(platform, notify, "Уведомление о квоте, оповещение об утрате записи")
Rel_R(platform, auth, "Проверка входа игрока")

SHOW_LEGEND()
@enduml
