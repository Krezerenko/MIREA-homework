	setProperty -d "Weight" 1.000000;
		select;

}

setProperty Name $currentSubject -onMod Komisarik;
if( `exists $tempSubjectName` )
{
	setProperty Name Komisarik -onMod $tempSubjectName;
}
attachCommandOptions - mirror $mirrorConstraintsWas;
